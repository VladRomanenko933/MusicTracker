@page "/albums"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MusicTracker.Models
@using MusicTracker.Data
@inject IDbContextFactory<MusicTracker.Data.MusicTrackerContext> DbFactory

<PageTitle>Альбоми - MusicTracker</PageTitle>

<h1>Альбоми</h1>

<p>
    <a href="albums/create">Create New</a>
</p>
<form method="get" class="row g-2 mb-3">
    <div class="col">
        <input name="search" value="@Search" class="form-control" placeholder="Пошук за назвою" />
    </div>
    <div class="col">
        <select name="artistId" class="form-select">
            <option value="">Усі артисти</option>
            @foreach (var a in artists)
            {
                <option value="@a.Id" selected="@(ArtistId == a.Id)">@a.Name</option>
            }
        </select>
    </div>
    <div class="col">
        <select name="sort" class="form-select">
            <option value="">За назвою</option>
            <option value="duration" selected="@(Sort == "duration")">За тривалістю</option>
            <option value="date" selected="@(Sort == "date")">За датою релізу</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Шукати</button>
    </div>
</form>

@if (Saved)
{
    <div class="alert alert-success">Альбом успішно збережено!</div>
}

@if (!albums.Any())
{
    <div class="alert alert-info">
        Записів ще немає.
        <a href="/albums/create">Додайте перший альбом</a>.
    </div>
}
else
{
    <div class="table-responsive">
        <QuickGrid Class="table" Items="@albums.Skip((CurrentPage - 1) * PageSize).Take(PageSize).AsQueryable()">
    <PropertyColumn Property="album => album.Title" Title="Назва альбому" />
    <PropertyColumn Property="album => album.Artist!.Name" Title="Артист" />
    <PropertyColumn Property="album => album.Genre!.Name" Title="Жанр" />
    <PropertyColumn Property="album => album.Review" Title="Відгук" />
    <PropertyColumn Property="album => album.DurationMinutes" Title="Тривалість (хв)" />
    <PropertyColumn Property="album => album.ReleaseDate" Title="Дата релізу" />
    <PropertyColumn Property="album => album.ListenedOn" Title="Дата прослуховування" />
    <PropertyColumn Property="album => album.IsFavorite" Title="Улюблене" />
    <PropertyColumn Property="album => album.Format" Title="Формат" />

    <TemplateColumn Context="album">
        <a href="@($"albums/edit?id={album.Id}")">Edit</a> |
        <a href="@($"albums/details?id={album.Id}")">Details</a> |
        <a href="@($"albums/delete?id={album.Id}")">Delete</a>
    </TemplateColumn>
        </QuickGrid>
    </div>
    <nav>
        @if (CurrentPage > 1) { 
            <a class="btn btn-outline-secondary" href="@($"albums?page={CurrentPage - 1}&search={Search}&artistId={ArtistId}&sort={Sort}")">Назад</a> 
        }
        <span class="mx-2">Сторінка @CurrentPage</span>
        @if (albums.Count > CurrentPage * PageSize) { 
            <a class="btn btn-outline-secondary" href="@($"albums?page={CurrentPage + 1}&search={Search}&artistId={ArtistId}&sort={Sort}")">Далі</a> 
        }
    </nav>
}
@code {
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public int? ArtistId { get; set; }
    [SupplyParameterFromQuery] public string? Sort { get; set; }
    [SupplyParameterFromQuery] public int? Page { get; set; }
    [SupplyParameterFromQuery(Name = "saved")]
    public bool Saved { get; set; }

    private int CurrentPage => Page is > 0 ? Page.Value : 1;
    private const int PageSize = 10;

    private List<Album> albums = new();
    private List<Artist> artists = new();

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        artists = await db.Artists.OrderBy(a => a.Name).ToListAsync();
        albums = await LoadAsync();
    }

    private async Task<List<Album>> LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var q = db.Albums.Include(x => x.Artist).Include(x => x.Genre).AsQueryable();

        if (!string.IsNullOrWhiteSpace(Search))
        {
            var s = Search.ToLowerInvariant();
            q = q.Where(x => x.TitleSearch.Contains(s));
        }

        if (ArtistId is int id)
            q = q.Where(x => x.ArtistId == id);

        q = Sort switch
        {
            "duration" => q.OrderByDescending(x => x.DurationMinutes),
            "date" => q.OrderByDescending(x => x.ReleaseDate),
            _ => q.OrderBy(x => x.Title)
        };

        return await q.ToListAsync();
    }
}
