@page "/albums/delete"
@using Microsoft.EntityFrameworkCore
@using MusicTracker.Models
@inject IDbContextFactory<MusicTracker.Data.MusicTrackerContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Album</h2>
    <hr />
    @if (album is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <div>
            <AlbumCard Album="album" Caption="Ви дійсно хочете видалити цей альбом?" ShowDetails="false" />
        </div>
        <EditForm method="post" Model="album" OnValidSubmit="DeleteAlbum" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(album is null)">Delete</button> |
            <a href="/albums">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Album? album;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        album = await context.Albums.Include(a => a.Artist).Include(a => a.Genre).FirstOrDefaultAsync(m => m.Id == Id);

        if (album is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteAlbum()
    {
        using var context = DbFactory.CreateDbContext();
        context.Albums.Remove(album!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/albums");
    }
}
