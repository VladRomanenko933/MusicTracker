@page "/albums/delete"
@using Microsoft.EntityFrameworkCore
@using MusicTracker.Models
@inject IDbContextFactory<MusicTracker.Data.MusicTrackerContext> DbFactory
@inject NavigationManager NavigationManager
@inject ILogger<Delete> Logger

<PageTitle>Видалити</PageTitle>

<h1>Видалити</h1>

<p>Видалити альбом «@album.Title»?</p>
<div>
    <h2>Альбом</h2>
    <hr />
    @if (album is null)
    {
        <div class="alert alert-warning">
            Запис не знайдено — можливо, його видалено.
            <a href="/albums">До переліку</a>.
        </div>
    }
    else {
        <div>
            <AlbumCard Album="album" Caption="Ви дійсно хочете видалити цей альбом?" ShowDetails="false" />
        </div>
        <EditForm method="post" Model="album" OnValidSubmit="DeleteAlbum" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(album is null)">Delete</button> |
            <a href="/albums">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Album? album;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        album = await context.Albums.Include(a => a.Artist).Include(a => a.Genre).FirstOrDefaultAsync(m => m.Id == Id);


    }

    private async Task DeleteAlbum()
    {
        using var context = DbFactory.CreateDbContext();
        context.Albums.Remove(album!);
        await context.SaveChangesAsync();
        Logger.LogInformation("Видалено альбом {Id}", album!.Id);
        NavigationManager.NavigateTo("/albums");
    }
}
