@page "/albums/details"
@using Microsoft.EntityFrameworkCore
@using MusicTracker.Models
@inject IDbContextFactory<MusicTracker.Data.MusicTrackerContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>Album</h2>
    <hr />
    @if (album is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <div>
            <AlbumCard Album="album" Caption="Деталі альбому" />
        </div>
        <div>
            <a href="@($"/albums/edit?id={album.Id}")">Edit</a> |
            <a href="@($"/albums")">Back to List</a>
        </div>
    }
</div>

@code {
    private Album? album;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        album = await context.Albums.FirstOrDefaultAsync(m => m.Id == Id);

        if (album is null)
        {
            NavigationManager.NotFound();
        }
    }
}
